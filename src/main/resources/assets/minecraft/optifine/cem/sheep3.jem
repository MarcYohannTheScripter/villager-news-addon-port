          "wooly_base_d682.rx": "sin(limb_swing*0.6662+pi)*1.4*limb_speed"
        },
        {
          "wooly_base_d683.rx": "sin(limb_swing*0.6662)*1.4*limb_speed"
        },
        {
          "wooly_base_46fljga5.rx": "1.5708+torad(cos(limb_swing*0.6662)*6.2)*limb_speed",
          "wooly_base_46fljga5.ty": "0+(1.5-sin(limb_swing*0.6662)*1.125)*limb_speed",
          "wooly_base_k966h_head.rx": "torad(head_pitch)+torad((sin(limb_swing*0.6662+torad(22))*6.2+1)*limb_speed)",
          "wooly_base_k966h_head.ry": "torad(head_yaw)",
          "wooly_base_k966h_head.ty": "-3.75+(1.5+cos(limb_swing*0.6662+torad(30))*1.125)*limb_speed"
        },
        {
          "wooly_base_3dafc.sx": "if(fmod(time+id*3.46,36.6666)>33.334,1,0)",
          "wooly_base_3dafc.sy": "if(fmod(time+id*3.46,36.6666)>33.334,1,0)",
          "wooly_base_3dafc.sz": "if(fmod(time+id*3.46,36.6666)>33.334,1,0)"
        },
