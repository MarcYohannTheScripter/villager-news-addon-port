        {
          "wooly_base_egml9.ty": "1.7+vnap_speaking*vnap_mouth_open*0.5",
          "wooly_base_egml9.sx": "(0.5+vnap_mouth_width*0.5)*vnap_speaking+(1-vnap_speaking)",
          "wooly_base_egml9.sy": "(1+vnap_mouth_open)*vnap_speaking+(1-vnap_speaking)",
          "wooly_base_l66l9.ty": "1+vnap_speaking*vnap_mouth_open*0.5",
          "wooly_base_l66l9.sx": "(0.5+vnap_mouth_width*0.5-vnap_mouth_closed)*vnap_speaking",
          "wooly_base_l66l9.sy": "(1-vnap_mouth_closed)*vnap_speaking",
          "wooly_base_l66l9.sz": "(1-vnap_mouth_closed)*vnap_speaking",
